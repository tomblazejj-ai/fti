# Nothing in this file is required. The app runs with zero registration and
# zero API keys: FRED via its public CSV download, CFTC, central-bank RSS and
# GDELT are all keyless. Copy to backend/.env only if you want to override.

# Optional FRED API key (free). Without it the keyless CSV download is used.
FRED_API_KEY=

# Optional Groq API key — AI on the FREE plan only (console.groq.com → API Keys).
# Never put the key anywhere else: not in code, not in chat, not on GitHub.
GROQ_API_KEY=

# Optional CFTC Socrata app token (free) — only raises the anonymous rate limit.
CFTC_APP_TOKEN=

# Reserved for later instruments (not used by XAUUSD):
BLS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=

# Defaults to backend/fti.db. Point at Postgres later, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# Background refresh interval in minutes (default 30).
# FTI_REFRESH_MINUTES=30
